# Copiar a .env y cambiar los valores:  cp .env.example .env
# .env NO se sube a git. scripts/create-secrets.sh lo convierte en Secrets de Kubernetes.
# Usar contrasenas alfanumericas: van dentro de URIs de conexion (postgresql://user:pass@host)
# y caracteres como @ : / # romperian la URI.

# --- Postgres de DATOS (raw / clean / inference) ---
DATA_DB_USER=mlops
DATA_DB_PASSWORD=cambiar_data
DATA_DB_NAME=mlops_data

# --- Postgres de METADATA de MLflow (experimentos, runs, Model Registry) ---
MLFLOW_DB_USER=mlflow
MLFLOW_DB_PASSWORD=cambiar_mlflow
MLFLOW_DB_NAME=mlflow

# --- MinIO (artifact store de MLflow) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=cambiar_minio123

# --- Registro de imagenes ---
DOCKERHUB_USER=dierick
